FROM python:3.11-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless poppler-utils \
    libgl1 libglib2.0-0 libgomp1 libsm6 libxext6 libxrender1 libgthread-2.0-0 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir --default-timeout=900 --retries 10 \
    "opendataloader-pdf[hybrid]" fastapi uvicorn

COPY server_hybrid.py .

EXPOSE 5002

ENV HF_HOME=/app/cache

CMD ["python", "server_hybrid.py"]
